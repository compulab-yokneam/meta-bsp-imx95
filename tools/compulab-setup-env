#!/bin/bash -e

MACHINE=${MACHINE:-ucm-imx95}
DISTRO=${DISTRO:-fsl-imx-xwayland}
EULA=1
T="../sources/meta-bsp-imx95/templates"
M="../sources/meta-bsp-imx95/tools/${MACHINE}"

# Allow per-command hardware settings, just like OE's MACHINE passthrough.
# oe-buildenv-internal merges and deduplicates this list during setup below.
BB_ENV_PASSTHROUGH_ADDITIONS="${BB_ENV_PASSTHROUGH_ADDITIONS:-} IMXBOOT_VARIANT DDR_TYPE DRAM_CONF"
export BB_ENV_PASSTHROUGH_ADDITIONS

BD=$(cat <<< $@ | awk '$0=$NF')

function fix_fsl_imx_base() {
    F=${BUILDDIR}/../sources/meta-imx/meta-imx-sdk/conf/distro/include/fsl-imx-base.inc
    sed -i 's/\(^DISTRO_FEATURES:remove = ".*\)\(pulseaudio\)\(.*"\)/\1\3/g' ${F}
}

function mach_function() {
    [[ -d ${M} ]] || return 0
    for _file in ${M}/*;do
        source ${_file}
    done
}

function temp_function() {
    for _d in ${T}/*;do
        _file=$(basename ${_d})
        for _f in ${_d}/*;do
        file ${_f} | grep -iq "shell" && source ${_f} >> conf/${_file} || {
cat << eof >> conf/${_file}

# Included from ${_f}
$(cat ${_f})

eof
    }
        done;
    done
}

if [[ -d ${BD} ]];then

echo "Back to the build environment ${BD}"
. setup-environment ${BD}

else

. imx-setup-release.sh -b $@

    temp_function
    mach_function
    fix_fsl_imx_base
fi
