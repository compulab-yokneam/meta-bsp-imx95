From 856d6ae4370c114c607bfa0afe3cee635f6950a6 Mon Sep 17 00:00:00 2001
From: Valentin Raevsky <valentin@compulab.co.il>
Date: Tue, 2 Sep 2025 10:59:40 +0300
Subject: [PATCH] compulab: cfg: Update mx95cplrpmsg config

Dercrease I2C2 and I2C4 credentials for LM1 M7.

Signed-off-by: Valentin Raevsky <valentin@compulab.co.il>
---
 configs/other/mx95cplrpmsg.cfg | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/configs/other/mx95cplrpmsg.cfg b/configs/other/mx95cplrpmsg.cfg
index bb192d5..d77e4ed 100755
--- a/configs/other/mx95cplrpmsg.cfg
+++ b/configs/other/mx95cplrpmsg.cfg
@@ -419,9 +419,9 @@ EDMA2_CH62_63       ACCESS
 FSB                 READONLY
 IRQSTEER_M7         OWNER
 ## For i.MX95 15x15 EVK
-LPI2C2              OWNER
+LPI2C2              ACCESS
 ## For i.MX95 19x19 EVK
-LPI2C4              OWNER
+LPI2C4              ACCESS
 LPIT1               OWNER
 LPTMR1              OWNER
 LPTMR2              OWNER
@@ -465,12 +465,12 @@ PIN_PDM_CLK         OWNER
 # we use one cfg for i.MX95-19x19-EVK and i.MX95-15x15-EVK,
 # so expose both LPI2C4 and LPI2C2 to M7.
 # LPI2C4 pins
-PIN_GPIO_IO30        OWNER
-PIN_GPIO_IO31        OWNER
+PIN_GPIO_IO30        ACCESS
+PIN_GPIO_IO31        ACCESS
 
 # LPI2C2 pins
-PIN_I2C2_SCL         OWNER
-PIN_I2C2_SDA         OWNER
+PIN_I2C2_SCL         ACCESS
+PIN_I2C2_SDA         ACCESS
 # Memory
 
 M7MIX               DATA, begin=0x020380000, end=0x02047FFFF
-- 
2.34.1

