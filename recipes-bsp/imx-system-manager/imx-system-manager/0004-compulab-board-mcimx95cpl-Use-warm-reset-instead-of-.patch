From a2bdd0bae54d09db5403d93b0040340ca0b7108b Mon Sep 17 00:00:00 2001
From: Valentin Raevsky <valentin@compulab.co.il>
Date: Wed, 6 Aug 2025 16:10:43 +0300
Subject: [PATCH 4/4] compulab: board mcimx95cpl: Use warm reset instead of
 wdog on B0

Signed-off-by: Valentin Raevsky <valentin@compulab.co.il>
---
 boards/mcimx95cpl/sm/brd_sm.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/boards/mcimx95cpl/sm/brd_sm.c b/boards/mcimx95cpl/sm/brd_sm.c
index cd48b59..eff4970 100755
--- a/boards/mcimx95cpl/sm/brd_sm.c
+++ b/boards/mcimx95cpl/sm/brd_sm.c
@@ -456,9 +456,11 @@ void BRD_SM_ShutdownRecordSave(dev_sm_rst_rec_t shutdownRec)
 /*--------------------------------------------------------------------------*/
 /* Reset board                                                              */
 /*--------------------------------------------------------------------------*/
+#define DONT_USE_WDOG_ANY
 int32_t BRD_SM_SystemReset(void)
 {
     int32_t status = SM_ERR_SUCCESS;
+#ifndef DONT_USE_WDOG_ANY
     rgpio_pin_config_t gpioConfig =
     {
         kRGPIO_DigitalOutput,
@@ -472,6 +474,7 @@ int32_t BRD_SM_SystemReset(void)
     /* Wait for PMIC to react */
     SystemTimeDelay(1000U);
 
+#endif
     /* Fall back to warm reset of the device */
     status = DEV_SM_SystemReset();
 
