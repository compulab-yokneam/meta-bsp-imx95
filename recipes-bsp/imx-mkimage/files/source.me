#!/bin/bash

do_make() {
    make SOC=iMX95 REV=@@IMX_SOC_REV@@ OEI=YES LPDDR_TYPE=lpddr5 clean
    make SOC=iMX95 REV=@@IMX_SOC_REV@@ OEI=YES LPDDR_TYPE=lpddr5 flash_all && mv flash.bin flash.bin_all
    make SOC=iMX95 REV=@@IMX_SOC_REV@@ OEI=YES LPDDR_TYPE=lpddr5 flash_a55 && mv flash.bin flash.bin_a55
}

cat << eof
    do_make -- issue flash_all/flash_a55 build
eof
